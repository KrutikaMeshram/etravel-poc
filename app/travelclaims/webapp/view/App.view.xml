<mvc:View
  controllerName="etravel.travelclaims.controller.App"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form"
  xmlns:u="sap.ui.unified"
  displayBlock="true">

  <ScrollContainer height="100%" vertical="true">
        <VBox class="sapUiSmallMargin">

          <!-- ===================== HEADER BANNER ===================== -->
          <VBox class="sapUiResponsiveMargin" alignItems="Center" backgroundDesign="Solid">
            <Title text="INDORAMA - BANGKOK" level="H2" class="sapUiTinyMarginTop"/>
            <Title text="FOREIGN TRAVELLING SUMMARY COVER PAGE" level="H3" class="sapUiTinyMarginBottom"/>
          </VBox>

          <!-- ===================== PRIMARY INFORMATION ===================== -->
          <Panel headerText="Primary Information" expandable="true" expanded="true" class="sapUiResponsiveMargin">
            <HBox>
              <!-- LEFT COLUMN -->
              <VBox width="50%" class="sapUiTinyMarginEnd">
                <form:SimpleForm layout="ResponsiveGridLayout" editable="true" labelSpanL="6" labelSpanM="6">
              <Label text="Employee Name" required="true"/>
              <Input value="{wizard>/employeeName}" editable="{= !${wizard>/viewMode} }"/>

              <Label text="Employee Email" required="true"/>
              <Input value="{wizard>/employeeEmail}" type="Email" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Employee Designation"/>
                  <Select selectedKey="{wizard>/employeeDesignation}" enabled="{= !${wizard>/viewMode} }">
                    <core:Item key="SVP and Above" text="SVP and Above"/>
                    <core:Item key="Vice President" text="Vice President"/>
                    <core:Item key="JVP and AVP" text="JVP and AVP"/>
                    <core:Item key="MGR and Below" text="MGR and Below"/>
                  </Select>

                  <Label text="Travel Destination (City)"/>
                  <Input value="{wizard>/travelDestinationCity}" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Travel Destination (Country)"/>
                  <Input value="{wizard>/travelDestinationCountry}" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Advance Confirmation"/>
                  <Select selectedKey="{wizard>/advanceConfirmation}" enabled="{= !${wizard>/viewMode} }">
                    <core:Item key="true" text="Yes"/>
                    <core:Item key="false" text="No"/>
                  </Select>

                  <Label text="Advance Currency"/>
                  <Select selectedKey="{wizard>/advanceCurrency}" enabled="{= !${wizard>/viewMode} }">
                    <core:Item key="USD" text="USD"/>
                    <core:Item key="EUR" text="EUR"/>
                    <core:Item key="THB" text="THB"/>
                  </Select>

                  <Label text="Advance Amount"/>
                  <Input value="{wizard>/advanceAmount}" type="Number" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Advance Refund Confirmation"/>
                  <Select selectedKey="{wizard>/advanceRefundConfirmation}" enabled="{= !${wizard>/viewMode} }">
                    <core:Item key="true" text="Yes"/>
                    <core:Item key="false" text="No"/>
                  </Select>

                  <Label text="Advance Refunded Amount"/>
                  <Input value="{wizard>/advanceRefundedAmount}" type="Number" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Leftover Advance Amount"/>
<Input value="{= (${wizard>/advanceRefundConfirmation} === true || ${wizard>/advanceRefundConfirmation} === 'true') ? ((${wizard>/advanceAmount} || 0) - (${wizard>/advanceRefundedAmount} || 0)) : 0 }" type="Number" editable="false"/>
                </form:SimpleForm>
              </VBox>

              <!-- RIGHT COLUMN -->
              <VBox width="50%" class="sapUiTinyMarginBegin">
                <form:SimpleForm layout="ResponsiveGridLayout" editable="true" labelSpanL="6" labelSpanM="6">
                  <Label text="SFID"/>
                  <Input value="{wizard>/sfid}" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Cost Center"/>
                  <Input value="{wizard>/costCenter}" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Expense Category"/>
                  <Select selectedKey="{wizard>/expenseCategory}" enabled="{= !${wizard>/viewMode} }">
                    <core:Item key="Regular Business Travel" text="Regular Business Travel"/>
                    <core:Item key="CAPEX Business Travel" text="CAPEX Business Travel"/>
                  </Select>

                  <Label text="Supervisor Name &amp; Designation"/>
                  <Input value="{wizard>/supervisorName}" editable="{= !${wizard>/viewMode} }"/>
                  <Input value="{wizard>/supervisorDesignation}" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Full Trip Schedule From"/>
                  <DatePicker value="{wizard>/tripScheduleFrom}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Full Trip Schedule To"/>
                  <DatePicker value="{wizard>/tripScheduleTo}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>

                  <Label text="Project Code / AUC Code"/>
                  <Input value="{wizard>/projectCode}" editable="{= !${wizard>/viewMode} }"/>

<Label text="Advance Amount Converted in Local Currency"/>
<Input value="{wizard>/advanceAmountLocalCurrency}" type="Number" editable="{= !${wizard>/viewMode} }"/>
                </form:SimpleForm>
              </VBox>
            </HBox>
          </Panel>

          <!-- ===================== PART 1: DAILY ALLOWANCE ===================== -->
          <Panel headerText="Part 1: Daily Allowance" expandable="true" expanded="true" class="sapUiResponsiveMargin">
            <Table items="{wizard>/dailyAllowances}" mode="None" noDataText="No travel legs added yet">
              <columns>
                <Column><Text text="Origin"/></Column>
                <Column><Text text="Origin Date"/></Column>
                <Column><Text text="Destination"/></Column>
                <Column><Text text="Reaching Date"/></Column>
                <Column><Text text="Departure Date"/></Column>
                <Column><Text text="Total Days"/></Column>
                <Column><Text text="Designation Band"/></Column>
                <Column><Text text="Per Diem Rate"/></Column>
                <Column><Text text="Currency"/></Column>
                <Column><Text text="FX Rate"/></Column>
                <Column><Text text="Amount THB"/></Column>
                <Column><Text text="Attachment *"/></Column>
                <Column/>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Input value="{wizard>origin}" editable="{= !${wizard>/viewMode} }"/>
                    <DatePicker value="{wizard>originDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <Input value="{wizard>destination}" editable="{= !${wizard>/viewMode} }"/>
                    <DatePicker value="{wizard>reachingDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <DatePicker value="{wizard>departureDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <Input value="{wizard>totalDays}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Select selectedKey="{wizard>designationBand}" enabled="{= !${wizard>/viewMode} }">
                      <core:Item key="SVP and Above" text="SVP and Above"/>
                      <core:Item key="Vice President" text="Vice President"/>
                      <core:Item key="JVP and AVP" text="JVP and AVP"/>
                      <core:Item key="MGR and Below" text="MGR and Below"/>
                    </Select>
                    <Input value="{wizard>dailyPerDiemRate}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Input value="{wizard>currency}" editable="{= !${wizard>/viewMode} }"/>
                    <Input value="{wizard>fxRate}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Text text="{wizard>amountTHB}"/>
                    <u:FileUploader value="{wizard>attachmentRef}" buttonText="Attach" tooltip="Attach supporting document" fileType="pdf,jpg,jpeg,png" width="9rem" visible="{= !${wizard>/viewMode} }"/>
                    <Button icon="sap-icon://delete" type="Transparent" press="onDeleteDailyAllowanceRow" visible="{= !${wizard>/viewMode} }"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <Button text="+ Add Travel" type="Transparent" press="onAddDailyAllowanceRow" class="sapUiTinyMarginTop" visible="{= !${wizard>/viewMode} }"/>
          </Panel>

          <!-- ===================== PART 2: HOTEL EXPENSES ===================== -->
          <Panel headerText="Part 2: Hotel Expenses" expandable="true" expanded="true" class="sapUiResponsiveMargin">
            <Table items="{wizard>/hotelExpenses}" mode="None" noDataText="No hotel expenses added yet">
              <columns>
                <Column><Text text="Hotel Name"/></Column>
                <Column><Text text="Check-In"/></Column>
                <Column><Text text="Check-Out"/></Column>
                <Column><Text text="Transaction Type"/></Column>
                <Column><Text text="Room Rate/Day"/></Column>
                <Column><Text text="Currency"/></Column>
                <Column><Text text="Other Hotel Exps"/></Column>
                <Column><Text text="FX Rate"/></Column>
                <Column><Text text="Total THB"/></Column>
                <Column><Text text="Attachment"/></Column>
                <Column/>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Input value="{wizard>hotelName}" editable="{= !${wizard>/viewMode} }"/>
                    <DatePicker value="{wizard>checkInDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <DatePicker value="{wizard>checkOutDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <Select selectedKey="{wizard>transactionType}" enabled="{= !${wizard>/viewMode} }">
                      <core:Item key="Cash" text="Cash"/>
                      <core:Item key="Credit Card" text="Credit Card"/>
                    </Select>
                    <Input value="{wizard>roomRatePerDay}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Input value="{wizard>currency}" editable="{= !${wizard>/viewMode} }"/>
                    <Input value="{wizard>otherHotelExpenses}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Input value="{wizard>fxRate}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Text text="{wizard>totalTHB}"/>
                    <u:FileUploader value="{wizard>attachmentRef}" buttonText="Attach" tooltip="Attach supporting document" fileType="pdf,jpg,jpeg,png" width="9rem" visible="{= !${wizard>/viewMode} }"/>
                    <Button icon="sap-icon://delete" type="Transparent" press="onDeleteHotelExpenseRow" visible="{= !${wizard>/viewMode} }"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <Button text="+ Add Hotel Expense" type="Transparent" press="onAddHotelExpenseRow" class="sapUiTinyMarginTop" visible="{= !${wizard>/viewMode} }"/>
          </Panel>

          <!-- ===================== PART 3: OTHER EXPENSES ===================== -->
          <Panel headerText="Part 3: Other Expenses at Travel" expandable="true" expanded="true" class="sapUiResponsiveMargin">
            <Table items="{wizard>/expenseItems}" mode="None" noDataText="No other expenses added yet">
              <columns>
                <Column><Text text="Description"/></Column>
                <Column><Text text="Category"/></Column>
                <Column><Text text="Date"/></Column>
                <Column><Text text="Transaction Type"/></Column>
                <Column><Text text="Currency"/></Column>
                <Column><Text text="Amount (Foreign)"/></Column>
                <Column><Text text="FX Rate"/></Column>
                <Column><Text text="THB Amount"/></Column>
                <Column><Text text="Attachment"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Input value="{wizard>description}" editable="{= !${wizard>/viewMode} }"/>
                    <Select selectedKey="{wizard>category}" enabled="{= !${wizard>/viewMode} }">
                      <core:Item key="Air Ticket" text="Air Ticket"/>
                      <core:Item key="Visa Exps" text="Visa Exps"/>
                      <core:Item key="Re-entry Exps" text="Re-entry Exps"/>
                      <core:Item key="Airport Tax" text="Airport Tax"/>
                      <core:Item key="Conveyance" text="Conveyance (Taxi/Transport)"/>
                      <core:Item key="Telephone" text="Telephone (Intl roaming)"/>
                      <core:Item key="Food &amp; Beverage" text="Food &amp; Beverage"/>
                      <core:Item key="Covid/Medical Test" text="Covid/Medical Test"/>
                      <core:Item key="Others" text="Others"/>
                    </Select>
                    <DatePicker value="{wizard>expenseDate}" valueFormat="yyyy-MM-dd" displayFormat="dd-MMM-yyyy" editable="{= !${wizard>/viewMode} }"/>
                    <Select selectedKey="{wizard>isCashTransaction}" enabled="{= !${wizard>/viewMode} }">
                      <core:Item key="true" text="Cash"/>
                      <core:Item key="false" text="Credit Card"/>
                    </Select>
                    <Input value="{wizard>currency}" editable="{= !${wizard>/viewMode} }"/>
                    <Input value="{wizard>amountForeign}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Input value="{wizard>fxRate}" type="Number" editable="{= !${wizard>/viewMode} }" liveChange="onRecalculate"/>
                    <Text text="{wizard>amountTHB}"/>
                    <u:FileUploader value="{wizard>attachmentRef}" buttonText="Attach" tooltip="Attach supporting document" fileType="pdf,jpg,jpeg,png" width="9rem" visible="{= !${wizard>/viewMode} }"/>
                    <Button icon="sap-icon://delete" type="Transparent" press="onDeleteExpenseItemRow" visible="{= !${wizard>/viewMode} }"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <Button text="+ Add Expense" type="Transparent" press="onAddExpenseItemRow" class="sapUiTinyMarginTop" visible="{= !${wizard>/viewMode} }"/>
          </Panel>

          <!-- ===================== PART 4: TOTAL CLAIM SUMMARY ===================== -->
          <Panel headerText="Part 4: Total Claim Summary" expandable="true" expanded="true" class="sapUiResponsiveMargin">
            <form:SimpleForm layout="ResponsiveGridLayout" editable="false" labelSpanL="4" labelSpanM="4">
              <Label text="Total Expenses Claimed"/>
              <Text text="{wizard>/totalExpensesClaimed}"/>

              <Label text="Total Claim Amount"/>
              <Text text="{wizard>/headerCurrency} {wizard>/totalClaimAmount}"/>

              <Label text="Remark"/>
              <TextArea value="{wizard>/remark}" editable="{= !${wizard>/viewMode} }" rows="2"/>

              <Label text="Declaration"/>
              <CheckBox selected="{wizard>/declarationConfirmed}" text="I confirm the information is correct" editable="{= !${wizard>/viewMode} }"/>
            </form:SimpleForm>

          <form:SimpleForm layout="ResponsiveGridLayout" editable="true" labelSpanL="4" labelSpanM="4" visible="{= ${wizard>/reviewMode} === true }">
            <Label text="Supervisor Approval Comment"/>
            <TextArea value="{wizard>/supervisorComment}" rows="2" placeholder="Add a comment (optional)"
              editable="{= ${wizard>/status} === 'SUBMITTED' }"/>

            <Label text="VP Approval Comment"/>
            <TextArea value="{wizard>/vpFinanceComment}" rows="2" placeholder="Add a comment (optional)"
              editable="{= ${wizard>/status} === 'SUPERVISOR_APPROVED' }"/>
          </form:SimpleForm>

          <HBox justifyContent="End" class="sapUiMediumMarginTop">
            <Button text="Save" press="onSaveClaim" visible="{= !${wizard>/viewMode} }"/>
            <Button text="Submit Claim" type="Emphasized" class="sapUiTinyMarginBegin" press="onSubmitClaim" visible="{= !${wizard>/viewMode} }"/>
            <Button text="Approve" type="Accept" class="sapUiTinyMarginBegin" press="onApproveFromReview" visible="{= ${wizard>/reviewMode} === true }"/>
            <Button text="Reject" type="Reject" class="sapUiTinyMarginBegin" press="onRejectFromReview" visible="{= ${wizard>/reviewMode} === true }"/>
            <Button text="Close" class="sapUiTinyMarginBegin" press="onCloseWizard"/>
          </HBox>
          </Panel>

        </VBox>
  </ScrollContainer>

</mvc:View>