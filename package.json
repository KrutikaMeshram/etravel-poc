{
  "name": "etravel-poc",
  "version": "1.0.0",
  "description": "eTravel PoC - CAP backend for Indorama Foreign Travel Claim digitization",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@cap-js/sqlite": "^3.1.0",
    "@sap/cds": "^10.1.0",
    "sqlite3": "^6.0.1",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-travelclaims": "cds watch --open travelclaims/webapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy etravel-poc --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        },
        "[production]": {
          "kind": "postgres"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/travelclaims"
  ]
}
